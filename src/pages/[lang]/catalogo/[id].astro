---
/**
 * Product page — one per ebook EDITION, generated only in the edition's
 * own language (/it/catalogo/<id>/ or /en/catalogo/<id>/). The edition
 * in the other language is linked via hreflang + language switch.
 * Buying: currency choice, then src/scripts/buy.ts calls the checkout
 * function and navigates to Stripe Checkout (no CSP change needed).
 * JSON-LD: Book (one Offer per currency) + BreadcrumbList.
 */
import Base from '../../../layouts/Base.astro';
import BookCard from '../../../components/BookCard.astro';
import {
  CURRENCIES,
  DEFAULT_CURRENCY,
  TAX_INCLUSIVE,
  categoryLabel,
  formatPrice,
  products,
  related,
  sibling,
  type Product,
} from '../../../data/books';
import { LANGUAGES, localePath, useTranslations, type Alternates, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return products.map((product) => ({ params: { lang: product.lang, id: product.id }, props: { product } }));
}

const lang = Astro.params.lang as Lang;
const { product } = Astro.props as { product: Product };
const t = useTranslations(lang);

const { title, subtitle } = product;
const catalogUrl = localePath(lang, 'catalogo/');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const coverAbs = new URL(product.cover, Astro.site).href;

// The same book in the other language(s): hreflang + language switch.
const alternates: Alternates = Object.fromEntries(
  LANGUAGES.flatMap((l) => {
    const ed = sibling(product, l);
    return ed ? [[l, localePath(l, `catalogo/${ed.id}/`)]] : [];
  })
);
const otherEditions = LANGUAGES.filter((l) => l !== lang).flatMap((l) => {
  const ed = sibling(product, l);
  return ed ? [{ ed, href: localePath(l, `catalogo/${ed.id}/`) }] : [];
});

const defaultCurrency = DEFAULT_CURRENCY[lang];
const taxNote = (c: (typeof CURRENCIES)[number]) => (TAX_INCLUSIVE[c] ? t('price_incl_tax') : t('price_excl_tax'));
const offers = CURRENCIES.map((c) => ({
  currency: c,
  label: formatPrice(product.prices[c], c, lang),
  note: taxNote(c),
}));

// No real sample pages yet: the preview box stays hidden until there are.
const SHOW_PREVIEW = false;

const relatedProducts = related(product);
const metaDescription = `${title}: ${subtitle}. ${product.lead}`.slice(0, 160);
const categoryUrl = localePath(lang, `categoria/${product.category}/`);

// Social scrapers don't render every format: use the pre-generated PNG card
// (scripts/generate-og.mjs → public/og/<id>.png, committed to the repo).
// Falls back to the site default if the PNG hasn't been generated yet.
import { existsSync } from 'node:fs';
const ogImage = existsSync(`public/og/${product.id}.png`) ? `/og/${product.id}.png` : '/og-default.png';

const specs: { label: string; value: string }[] = [
  ...(product.series ? [{ label: t('bk_series'), value: product.series }] : []),
  { label: t('bk_lang'), value: t('bk_lang_value') },
  { label: t('bk_format'), value: t('bk_format_value') },
  { label: t('bk_pages_pdf'), value: String(product.pages) },
  { label: t('bk_year'), value: String(product.year) },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: title,
    alternativeHeadline: subtitle,
    author: { '@type': 'Organization', name: product.author },
    inLanguage: product.lang,
    bookFormat: 'https://schema.org/EBook',
    numberOfPages: product.pages,
    datePublished: String(product.year),
    image: coverAbs,
    publisher: { '@type': 'Organization', name: 'Nava Editore' },
    url: pageUrl,
    offers: CURRENCIES.map((c) => ({
      '@type': 'Offer',
      price: product.prices[c].toFixed(2),
      priceCurrency: c,
      availability: 'https://schema.org/InStock',
      url: pageUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav_home'), item: new URL(localePath(lang), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t('nav_catalog'), item: new URL(catalogUrl, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: categoryLabel(product.category, lang), item: new URL(categoryUrl, Astro.site).href },
      { '@type': 'ListItem', position: 4, name: title, item: pageUrl },
    ],
  },
];
---

<Base
  {lang}
  title={`${title} — Nava`}
  description={metaDescription}
  active="catalog"
  ogType="book"
  {ogImage}
  {jsonLd}
  {alternates}
>
  <div class="container-x page">
    <nav aria-label={t('aria_breadcrumb')} class="breadcrumb">
      <a href={catalogUrl} class="back link-inline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        {t('bk_back')}
      </a>
    </nav>

    <article class="product">
      <div class="cover-col">
        {/* data-tilt: mouse-follow 3D handled by scripts/tilt.ts
            (desktop pointer only, off with prefers-reduced-motion) */}
        <div class="tilt" data-tilt>
          <img
            src={product.cover}
            width="600"
            height="960"
            loading="eager"
            decoding="async"
            class="cover main-cover"
            alt={`${t('aria_cover_prefix')} ${title}`}
            data-vt={`cover-${product.id}`}
          />
          <span class="sheen" aria-hidden="true"></span>
        </div>
      </div>

      <div>
        <p class="smallcaps genre">
          <a href={categoryUrl} class="genre-link text-accent">{categoryLabel(product.category, lang)}</a>
        </p>
        <h1 class="serif title">{title}</h1>
        <p class="serif text-muted subtitle"><em>{subtitle}</em></p>
        <p class="author">{product.author}</p>

        <div class="buybox" data-buybox>
          <p class="serif price" data-price aria-live="polite">{formatPrice(product.prices[defaultCurrency], defaultCurrency, lang)}</p>
          <p class="text-muted tax-note" data-tax-note>{taxNote(defaultCurrency)}</p>

          <fieldset class="currency">
            <legend class="smallcaps text-muted currency-h">{t('bk_currency')}</legend>
            <div class="currency-opts">
              {offers.map((o) => (
                <label class="cur">
                  <input
                    type="radio"
                    name="currency"
                    value={o.currency}
                    checked={o.currency === defaultCurrency}
                    data-label={o.label}
                    data-note={o.note}
                  />
                  <span>{o.currency}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="buy">
            <button
              type="button"
              class="btn btn-primary"
              data-buy
              data-product={product.id}
              data-lang={lang}
              data-loading={t('buy_loading')}
              hidden
            >{t('buy_now')}</button>
            <noscript><p class="text-muted">{t('bk_noscript')}</p></noscript>
            {product.amazonLink && <a href={product.amazonLink} class="btn btn-ghost">{t('buy_amazon')}</a>}
          </div>
          <p class="buy-error" role="alert" data-buy-error hidden>{t('buy_error')}</p>
          <p class="text-muted delivery">{t('bk_delivery')}</p>
          <p class="text-muted delivery">{t('bk_uk_note')}</p>
        </div>

        <dl class="specs">
          {specs.map((spec) => (
            <div class="spec-row">
              <dt class="text-muted">{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>

        {otherEditions.map(({ ed, href }) => (
          <p class="other-ed">
            {t('bk_other_edition')} <a href={href} class="link-inline" hreflang={ed.lang} lang={ed.lang}>{ed.title}</a>
          </p>
        ))}
      </div>
    </article>

    <section class:list={['desc-block', { 'with-preview': SHOW_PREVIEW }]}>
      <div class="prose prose-dropcap desc">
        <p><strong>{product.lead}</strong></p>
        {product.description.map((p) => <p>{p}</p>)}
        <ul>
          {product.highlights.map((h) => <li>{h}</li>)}
        </ul>
        {product.closing.map((p) => <p>{p}</p>)}
      </div>
      {SHOW_PREVIEW && (
        <aside class="preview reveal">
          <div class="preview-box">
            <h2 class="serif preview-h">{t('bk_preview_title')}</h2>
            <div class="preview-ph text-muted">{t('bk_preview_msg')}</div>
          </div>
        </aside>
      )}
    </section>

    {relatedProducts.length > 0 && (
      <section class="related">
        <h2 class="serif smallcaps related-h">{t('bk_related')}</h2>
        <div class="related-grid">
          {relatedProducts.map((rel) => <BookCard product={rel} {lang} />)}
        </div>
      </section>
    )}
  </div>

  <script src="../../../scripts/tilt.ts"></script>
  <script src="../../../scripts/buy.ts"></script>
</Base>

<style>
  .page { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .breadcrumb { margin-bottom: var(--space-6); }
  .back { display: inline-flex; align-items: center; gap: 0.25rem; font-size: var(--text-sm); border-bottom: 0; }

  .product { display: grid; grid-template-columns: 1fr; gap: var(--space-7); align-items: start; }
  @media (min-width: 768px) {
    .product { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .cover-col { position: sticky; top: 96px; }
  }
  .main-cover { max-width: 420px; }
  .tilt {
    position: relative; display: inline-block; max-width: 420px;
    transform-style: preserve-3d; will-change: transform;
  }
  .sheen {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.18) 50%, transparent 65%);
    transition: opacity var(--speed) var(--ease);
  }

  .genre { font-size: var(--text-sm); }
  .genre-link { border-bottom: 1px solid transparent; transition: border-color var(--speed) var(--ease); }
  .genre-link:hover { border-bottom-color: var(--accent-text); }
  .title { font-size: var(--text-5xl); margin-top: var(--space-2); }
  .subtitle { font-size: var(--text-xl); margin-top: var(--space-3); }
  .author { margin-top: var(--space-4); font-size: var(--text-lg); }

  .price { font-size: var(--text-3xl); margin-top: var(--space-5); }
  .tax-note { font-size: var(--text-sm); margin-top: var(--space-1); }
  .currency { border: 0; padding: 0; margin: var(--space-4) 0 0; }
  .currency-h { font-size: var(--text-sm); padding: 0; margin-bottom: var(--space-2); }
  .currency-opts { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .cur {
    display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.45rem 0.8rem; min-height: 44px; font-size: var(--text-sm);
  }
  .cur:has(input:checked) { border-color: var(--ink); }
  .cur input { accent-color: var(--accent); margin: 0; }
  .buy { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .buy-error { margin-top: var(--space-3); color: var(--accent-text); font-size: var(--text-sm); }
  .delivery { margin-top: var(--space-3); font-size: var(--text-sm); max-width: 46ch; }

  .specs { margin: var(--space-6) 0 0; font-size: var(--text-sm); }
  .spec-row {
    display: flex; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) 0; border-bottom: 1px solid var(--line);
  }
  .spec-row dd { margin: 0; text-align: right; }
  .other-ed { margin-top: var(--space-5); font-size: var(--text-sm); }

  .desc-block { margin-top: var(--space-8); display: grid; grid-template-columns: 1fr; gap: var(--space-7); }
  @media (min-width: 768px) {
    .desc-block { margin-top: var(--space-9); }
    .desc-block.with-preview { grid-template-columns: 1fr 320px; }
  }
  .desc { font-size: var(--text-lg); }
  .preview-box { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-5); background: var(--surface); }
  .preview-h { font-size: var(--text-xl); }
  .preview-ph {
    margin-top: var(--space-4); aspect-ratio: 3 / 4;
    border: 1px dashed var(--line); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    text-align: center; font-size: var(--text-sm); padding: var(--space-5);
  }

  .related { margin-top: var(--space-9); }
  .related-h { font-size: var(--text-3xl); margin-bottom: var(--space-7); }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: 3.5rem 2rem; }
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
