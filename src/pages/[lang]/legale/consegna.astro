---
/** Digital delivery (replaces "Spedizioni e resi"; old URL redirects here). */
import Legal from '../../../layouts/Legal.astro';
import { COMPANY } from '../../../data/company';
import { LANGUAGES, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const C = COMPANY;
---

<Legal {lang} title="Consegna digitale" description="Come ricevi gli ebook Nava: email con il link, formati, dispositivi, cosa fare se l'email non arriva.">
  <h2>1. Come ricevi l'ebook</h2>
  <p>
    Subito dopo il pagamento ti mandiamo un'email con il link alla pagina di download. Da lì scarichi il
    PDF e l'EPUB. Il link vale 72 ore e permette 5 download per ciascun file.
  </p>

  <h2>2. Su quali dispositivi</h2>
  <p>
    Il PDF si apre su computer, tablet e telefono e si può stampare. L'EPUB funziona con la maggior parte
    degli e-reader e delle app di lettura. Su Kindle puoi caricarlo con "Send to Kindle" di Amazon.
  </p>

  <h2>3. Se l'email non arriva</h2>
  <p>
    Controlla lo spam. Se dopo qualche minuto non c'è, scrivi a <a href={`mailto:${C.email}`}>{C.email}</a> con l'indirizzo usato per il pagamento.
  </p>

  <h2>4. Costi</h2>
  <p>La consegna è gratuita. Non ci sono spese di spedizione.</p>
</Legal>
