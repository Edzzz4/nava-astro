# Copy to .env (git-ignored) for `npx netlify-cli dev` and the scripts.
# Never commit real keys. In Netlify, set the same names per context:
# "Deploy Previews" → test keys, "Production" → live keys (after the STOP).

# Stripe (test mode: sk_test_…). Webhook secret: printed by
#   stripe listen --forward-to localhost:8888/.netlify/functions/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "false" until Stripe Tax is set up in the Dashboard (origin address, registrations).
STRIPE_AUTOMATIC_TAX=true

# Resend. Until navaeditore.com is verified, the test sender only delivers
# to the Resend account's own address.
RESEND_API_KEY=
MAIL_FROM=Nava Editore <onboarding@resend.dev>

# Signs download links: random, ≥ 32 chars, different per context.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_SECRET=

# Local only: where dev-seed-books.js reads the files.
BOOKS_DIR=/Users/<utente>/Desktop/nava-libri/releases
