# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
# any other env file (live keys, Deploy Preview values…): never commit
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local tooling
.claude/

# Book files (PDF/EPUB) must NEVER be committed: this repo is public.
# They live in Netlify Blobs, uploaded from ~/Desktop/nava-libri.
*.pdf
*.epub
*.mobi
*.azw3

# Netlify CLI local state
.netlify/
# generated by `netlify dev` (Edge Functions runtime)
deno.lock

# Local-only helper: seeds the `netlify dev` Blobs sandbox from ~/Desktop/nava-libri.
netlify/functions/dev-seed-books.js
